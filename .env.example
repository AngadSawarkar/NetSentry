
# Backend Network Configuration
NETSENTRY_BACKEND_HOST=192.168.56.103
NETSENTRY_BACKEND_PORT=5000
NETSENTRY_BACKEND_URL=http://192.168.56.103:5000

# Packet Sensor Configuration
NETSENTRY_INTERFACE=enp0s8
NETSENTRY_MONITORED_IP=192.168.56.103
NETSENTRY_CAPTURE_FILTER=dst host 192.168.56.103 and (tcp or icmp or udp port 53)

# Intrusion Detection Thresholds & Windows
NETSENTRY_SCAN_WINDOW=10
NETSENTRY_PORT_THRESHOLD=10

NETSENTRY_SYN_WINDOW=5
NETSENTRY_SYN_THRESHOLD=50

NETSENTRY_ICMP_WINDOW=5
NETSENTRY_ICMP_THRESHOLD=50

NETSENTRY_CONNECTION_WINDOW=10
NETSENTRY_CONNECTION_THRESHOLD=20

NETSENTRY_DNS_WINDOW=10
NETSENTRY_DNS_THRESHOLD=30
NETSENTRY_REPEATED_DNS_THRESHOLD=15

# Synchronization & Heartbeat Intervals (seconds)
NETSENTRY_TRAFFIC_UPDATE_INTERVAL=5
NETSENTRY_DEVICE_UPDATE_INTERVAL=10
NETSENTRY_CONNECTION_UPDATE_INTERVAL=10
NETSENTRY_HEARTBEAT_INTERVAL=5
NETSENTRY_HEARTBEAT_TIMEOUT=15
NETSENTRY_HTTP_TIMEOUT=5

# Database Configuration (configured in backend/.env)
# DB_HOST=localhost
# DB_USER=mysql_username
# DB_PASSWORD=mysql_password
# DB_NAME=db_name
